rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function role() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isSignedIn() && (role() == 'ADMIN' || role() == 'SUPER_ADMIN');
    }

    function isCustomer() {
      return isSignedIn() && role() == 'CUSTOMER';
    }

    function isCourier() {
      return isSignedIn() && role() == 'COURIER';
    }

    function isMerchant() {
      return isSignedIn() && role() == 'MERCHANT';
    }

    function isOwner(userId) {
      return isSignedIn() && uid() == userId;
    }

    // Default deny. Financial writes go through Cloud Functions only.
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'status', 'commissionRate'])) || isAdmin();
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isOwner(customerId) || isAdmin();
      allow create: if isOwner(customerId);
      allow update: if isOwner(customerId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /merchants/{merchantId} {
      allow read: if isSignedIn();
      allow create: if isOwner(merchantId) || isAdmin();
      allow update: if (isOwner(merchantId) && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['status', 'commissionRate', 'outstandingAmount'])) || isAdmin();
      allow delete: if isAdmin();
    }

    match /couriers/{courierId} {
      allow read: if isOwner(courierId) || isAdmin();
      allow create: if isOwner(courierId) || isAdmin();
      allow update: if (isOwner(courierId) && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['status', 'approvalStatus'])) || isAdmin();
      allow delete: if isAdmin();
    }

    match /menus/{menuId} {
      allow read: if isSignedIn();
      allow create, update: if isMerchant() || isAdmin();
      allow delete: if isMerchant() || isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isMerchant() || isAdmin();
    }

    // Orders: clients may read own orders. Creates/updates of money fields
    // must go through Cloud Functions (server-authoritative).
    match /orders/{orderId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.customerId == uid())
        || (isCourier() && resource.data.courierId == uid());
      allow create, update, delete: if false;
    }

    match /order_items/{itemId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /order_merchants/{orderMerchantId} {
      allow read: if isAdmin()
        || (isMerchant() && resource.data.merchantId == uid())
        || (isSignedIn() && exists(/databases/$(database)/documents/orders/$(resource.data.orderId))
            && get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.customerId == uid());
      allow create, update, delete: if false;
    }

    match /courier_assignments/{assignmentId} {
      allow read: if isAdmin() || (isCourier() && resource.data.courierId == uid());
      allow create, update, delete: if false;
    }

    match /courier_locations/{courierId} {
      allow read: if isAdmin()
        || isOwner(courierId)
        || (isSignedIn() && resource.data.activeOrderId != null);
      allow write: if isOwner(courierId) || isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerId == uid());
      allow write: if false;
    }

    match /transactions/{transactionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /merchant_settlements/{settlementId} {
      allow read: if isAdmin() || (isMerchant() && resource.data.merchantId == uid());
      allow create: if isMerchant() && request.resource.data.merchantId == uid()
        && request.resource.data.status == 'PENDING';
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /merchant_invoices/{invoiceId} {
      allow read: if isAdmin() || (isMerchant() && resource.data.merchantId == uid());
      allow write: if isAdmin();
    }

    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == uid());
      allow write: if false;
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /promos/{promoId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
