# Salin ke 03-backend-lokal/.env (jangan di-commit).

# --- Supabase (PostgreSQL) — untuk uji coba multi-device ---
# Ganti [YOUR-PASSWORD] dengan password database Supabase.

# Runtime + migrasi (session pooler, port 5432 — IPv4-friendly)
DATABASE_URL=postgresql://postgres.gwegjchemynetbhawyxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Opsional: transaction pooler untuk production (port 6543)
# DATABASE_URL=postgresql://postgres.gwegjchemynetbhawyxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Kunci Google Maps (Distance Matrix + Geocoding di server).
# Aktifkan API: Distance Matrix, Geocoding, Maps JavaScript.
GOOGLE_MAPS_API_KEY=

# Opsional: kunci khusus browser (restrict HTTP referrer). Jika kosong, pakai GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_BROWSER_KEY=

# Opsional: port API (default 3001)
# PORT=3001
