# Salin ke 03-backend-lokal/.env (jangan di-commit).

# Kunci Google Maps (Distance Matrix + Geocoding di server).
# Aktifkan API: Distance Matrix, Geocoding, Maps JavaScript.
GOOGLE_MAPS_API_KEY=

# Opsional: kunci khusus browser (restrict HTTP referrer). Jika kosong, pakai GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_BROWSER_KEY=
