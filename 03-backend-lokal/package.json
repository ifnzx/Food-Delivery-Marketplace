{
  "name": "food-delivery-local-api",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:lan": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "seed": "tsx src/seed.ts",
    "db:push": "prisma db push",
    "db:reset": "prisma db push && tsx src/seed.ts",
    "db:local:generate": "prisma generate",
    "db:supabase:generate": "prisma generate --schema=prisma/schema.supabase.prisma",
    "db:supabase:push": "prisma db push --schema=prisma/schema.supabase.prisma",
    "db:supabase:setup": "npm run db:supabase:generate && npm run db:supabase:push && npm run seed",
    "studio": "prisma studio --port 5555"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.0",
    "prisma": "^6.13.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
